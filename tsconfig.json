{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-inceptura/types/**/*.ts",
    ".next-inceptura/dev/types/**/*.ts",
    ".next-employaa/types/**/*.ts",
    ".next-employaa/dev/types/**/*.ts",
    ".next-leaders-pinnacle/types/**/*.ts",
    ".next-leaders-pinnacle/dev/types/**/*.ts",
    ".next-go-travel-global/types/**/*.ts",
    ".next-go-travel-global/dev/types/**/*.ts",
    ".next-thinkrunspace/types/**/*.ts",
    ".next-thinkrunspace/dev/types/**/*.ts",
    ".next-elevatrain/types/**/*.ts",
    ".next-elevatrain/dev/types/**/*.ts",
    ".next-remunerax/types/**/*.ts",
    ".next-remunerax/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
